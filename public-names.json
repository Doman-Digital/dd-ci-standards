  "allow": [
    {
      "repo": "*",
      "path": "(^|/)(pnpm-lock\\.yaml|package-lock\\.json|yarn\\.lock|bun\\.lock)$",
      "line": "(integrity|sha(1|256|384|512)[-:])",
      "reason": "a lockfile's integrity hash is random base64, and a short name on this list can turn up in it by chance"
    },
    {
      "repo": "*",
      "line": "^\\s*(?:-\\s*)?uses:\\s*[\"']?Doman-Digital/",
      "reason": "a workflow or action reference names our own repo; a client repo has to call the shared workflows this way"
    },
    {
      "repo": "*",
      "path": "(^|/)LICEN[CS]E(\\.\\w+)?$",
      "reason": "a licence's copyright line names the holder, which is the owner's legal right and duty"
    },
    {
      "repo": "Doman-Digital/dd-ci-standards",
      "path": "^\\.github/workflows/renovate\\.yml$",
      "line": "^\\s*-\\s*[\\w.-]+\\s*$",
      "reason": "renovate.yml lists the GitHub owners Renovate runs on; the reusable workflow cannot read a private repo"
    },
    {
      "repo": "Doman-Digital/dd-ci-standards",
      "path": "^budget\\.yml$",
      "line": "^\\s+[\\w.-]+:\\s*(#.*)?$",
      "reason": "budget.yml is keyed by repo name, and CI-007 and CI-028 read it inside client repos at run time"
    },
    {
      "repo": "Doman-Digital/dd-ci-standards",
      "path": "^scanners\\.json$",
      "line": "^\\s*\"[\\w.-]+/[\\w.-]+\"\\s*:",
      "reason": "scanners.json is keyed by owner/name, which the policy check reads inside that repo at run time"
    },
    {
      "repo": "Doman-Digital/dd-ci-standards",
      "path": "^lib/rules\\.mjs$",
      "line": "HOUSE_USES\\s*=",
      "reason": "the HOUSE_USES pattern names the second GitHub owner whose workflows count as our own"
    }
  ]
}
